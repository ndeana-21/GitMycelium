#include <winver.h>

IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/packaging/icons/gitmycelium.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@GMC_BUILD_NUMBER@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@GMC_BUILD_NUMBER@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GitMycelium contributors"
            VALUE "FileDescription", "GitMycelium"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "gitmycelium"
            VALUE "OriginalFilename", "GitMycelium.exe"
            VALUE "ProductName", "GitMycelium"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
